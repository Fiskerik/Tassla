{
  "expo": {
    "name": "Tassla", "slug": "tassla", "version": "0.1.0", "scheme": "tassla",
    "orientation": "portrait", "userInterfaceStyle": "light",
    "icon": "./assets/images/tassla-icon.png",
    "extra": { "tasslaLogo": "./assets/images/tassla-logo.svg" },
    "ios": {
      "bundleIdentifier": "com.erimaliab.tassla", "supportsTablet": false,
      "infoPlist": { "ITSAppUsesNonExemptEncryption": false }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      ["expo-notifications", { "defaultChannel": "tassla-reminders-v1" }],
      "expo-image",
      ["expo-splash-screen", { "backgroundColor": "#F7F1E7", "image": "./assets/images/tassla-icon.png", "imageWidth": 200, "resizeMode": "contain" }]
    ],
    "experiments": { "typedRoutes": true }
  }
}
